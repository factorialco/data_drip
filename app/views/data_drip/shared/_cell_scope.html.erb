<%# Where the new run executes besides this cell. Locals: runnable_type
    (:backfill or :script).

    "Run this in multiple cells", only in multi-cell mode: a fresh form ("Run
    again" included) starts ticked with every cell picked; a form shown again
    after a failed create keeps what was submitted. Unticked, the run is
    created exactly as in single-cell DataDrip: no group, no dispatches. The
    current cell is always included, so the list only offers the other cells.

    Each linked cell (DataDrip.linked_cells) gets a box of its own, independent
    of the one above. A fresh form ticks it when the cell's `default_for`
    includes this run type; a form shown again keeps what was submitted. %>
<% multi_cell = DataDrip.multi_cell? %>
<% linked_cells = DataDrip.resolved_linked_cells %>
<% if multi_cell || linked_cells.any? %>
  <% current_cell = DataDrip.resolved_current_cell_id %>
  <% remote_cells = DataDrip.remote_cell_ids %>
  <% submitted_ticked = !request.get? && params[:multi_cell] == "1" %>
  <% enabled = request.get? || submitted_ticked %>
  <% selected_cells = submitted_ticked ? Array(params[:target_cell_ids]).map(&:to_s) : remote_cells %>
  <% submitted_linked = Array(params[:linked_cell_ids]).map(&:to_s) %>

  <fieldset class="mb-5" data-controller="cell-scope">
    <legend class="<%= DataDrip::BackfillRunsHelper::LABEL_CLASSES %>">Cells</legend>
  <% if multi_cell %>

    <div class="mt-2 flex h-lh items-center gap-x-2 text-sm">
      <%= check_box_tag :multi_cell, "1", enabled,
          class: "size-4 accent-drip-700 dark:accent-drip-400",
          data: { action: "change->cell-scope#toggle" } %>
      <%= label_tag :multi_cell, class: "text-zinc-700 dark:text-zinc-300" do %>
        Run this in multiple cells
      <% end %>
    </div>
    <p class="mt-1.5 text-sm text-pretty text-zinc-500 dark:text-zinc-400">
      Unticked, the run executes only in this cell (<span class="font-mono text-xs"><%= current_cell %></span>).
    </p>

    <div
      class="mt-2 ml-6 space-y-2 rounded-lg bg-zinc-50 p-3 dark:bg-white/5"
      data-cell-scope-target="cells"
      <%= "hidden" unless enabled %>
    >
      <div class="flex items-center gap-x-2 text-sm">
        <%= check_box_tag "current_cell_always", "1", true,
            disabled: true,
            class: "size-4 accent-drip-700 opacity-50 dark:accent-drip-400" %>
        <span class="font-mono text-xs text-zinc-500 dark:text-zinc-400"><%= current_cell %></span>
        <span class="text-xs text-zinc-400 dark:text-zinc-500">· this cell, always included</span>
      </div>
      <% remote_cells.each do |cell_id| %>
        <div class="flex items-center gap-x-2 text-sm">
          <%= check_box_tag "target_cell_ids[]",
              cell_id,
              selected_cells.include?(cell_id),
              id: "target_cell_#{cell_id.parameterize(separator: "_")}",
              disabled: !enabled,
              class: "size-4 accent-drip-700 dark:accent-drip-400",
              data: { cell_scope_target: "checkbox" } %>
          <%= label_tag "target_cell_#{cell_id.parameterize(separator: "_")}",
              cell_id,
              class: "font-mono text-xs text-zinc-700 dark:text-zinc-300" %>
        </div>
      <% end %>
      <p class="text-sm text-pretty text-zinc-500 dark:text-zinc-400">
        The run executes independently in each cell, against that cell's data.
      </p>
    </div>
  <% else %>
    <p class="mt-1.5 text-sm text-pretty text-zinc-500 dark:text-zinc-400">
      The run executes in this cell (<span class="font-mono text-xs"><%= current_cell %></span>).
    </p>
  <% end %>

    <% linked_cells.each do |linked_cell| %>
      <% box_id = "linked_cell_#{linked_cell.id.parameterize(separator: "_")}" %>
      <% ticked = request.get? ? linked_cell.default_for?(runnable_type) : submitted_linked.include?(linked_cell.id) %>
      <div class="mt-3 flex h-lh items-center gap-x-2 text-sm">
        <%= check_box_tag "linked_cell_ids[]",
            linked_cell.id,
            ticked,
            id: box_id,
            class: "size-4 accent-drip-700 dark:accent-drip-400" %>
        <%= label_tag box_id, class: "text-zinc-700 dark:text-zinc-300" do %>
          Also run in <%= linked_cell.label %>
          <% if linked_cell.label != linked_cell.id %>
            <span class="font-mono text-xs text-zinc-500 dark:text-zinc-400">(<%= linked_cell.id %>)</span>
          <% end %>
        <% end %>
      </div>
    <% end %>
    <% if linked_cells.any? %>
      <p class="mt-1.5 text-sm text-pretty text-zinc-500 dark:text-zinc-400">
        A linked cell is a separate deployment: the run executes there against its own data.
      </p>
    <% end %>
  </fieldset>
<% end %>
